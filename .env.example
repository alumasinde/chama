# Export these in your shell or process manager; the server reads the process env. Never commit real secrets.
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
TRUST_PROXY=false
SHUTDOWN_TIMEOUT=15s

# Local Postgres from docker-compose (host port 5434 avoids a system install).
DATABASE_URL=postgres://chama:chama@localhost:5434/chama?sslmode=disable

# Tokens
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ACCESS_TTL=15m
STEP_UP_TTL=5m
REGISTRATION_TTL=15m
REFRESH_TTL=720h

# 32 bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# OTP
OTP_HASH_KEY=dev-only-otp-hash-key-change-me
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=console

# PIN
PIN_MAX_ATTEMPTS=5
PIN_LOCK_DURATION=15m
